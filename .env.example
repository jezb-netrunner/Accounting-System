# Which data adapter backs the repository ports. "local" = IndexedDB (Dexie),
# works fully offline. "supabase" = stubbed adapter, throws NotImplemented
# until Supabase integration lands.
VITE_DATA_ADAPTER=local

# Required only once VITE_DATA_ADAPTER=supabase is implemented.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
